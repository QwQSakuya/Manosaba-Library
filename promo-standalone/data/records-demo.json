  "rules": [
    {
      "id": "rule-Ⅰ",
      "num": "Ⅰ",
      "title": "生活规定",
      "sections": [
        {
          "title": "牢房滞留",
          "items": [
            "除放风时间以外，囚犯须待在与囚犯编号对应的牢房之内。",
            "若在非放风时间被发现身处牢房外，将当场被移送至惩罚室（惩罚室关禁闭2天）。"
          ]
        },
        {
          "title": "监视体制",
          "items": [
            "看守会常时巡逻，一旦发现囚犯有违反规定的行为，则会将其移送至惩罚室。"
          ]
        },
        {
          "title": "衣物的处理",
          "items": [
            "囚犯须每日将衣服丢弃于淋浴房内的垃圾滑槽中。",
            "焚烧炉会在每周一15时启动，处理废弃物。"
          ]
        },
        {
          "title": "身体不适及受伤时的应对",
          "items": [
            "即使在拘禁时间内，若出现身体不适或受伤的情况，准许其在医务室进行休息。",
            "允许最多1名看护人员陪同。"
          ]
        },
        {
          "title": "用餐时间",
          "items": [
            "提供1日3餐，在各放风时间内于食堂用餐。",
            "若超过用餐时间，丧失用餐权利。"
          ]
        },
        {
          "title": "就寝规定",
          "items": [
            "晚上10时至早上6时必须在牢房内就寝。",
            "熄灯后，囚犯之间的交谈亦属于应受惩罚的情况。"
          ]
        }
      ],
      "source": [
        "魔女图鉴·规定"
      ]
    },
    {
      "id": "rule-Ⅱ",
      "num": "Ⅱ",
      "title": "警卫巡逻",
      "sections": [
        {
          "title": "定期巡逻",
          "items": [
            "警卫会在全区域范围常时巡逻。",
            "巡逻排班不会告知囚犯。"
          ]
        },
        {
          "title": "发现违规时的罚则",
          "items": [
            "非放风时间的外出：惩罚室禁闭2天。",
            "对看守的反抗：若有暴力行为，将当场对其处刑。"
          ]
        }
      ],
      "source": [
        "魔女图鉴·规定"
      ]
    },
    {
      "id": "rule-Ⅲ",
      "num": "Ⅲ",
      "title": "放风时间的规定",
      "sections": [
        {
          "title": "放风时间的范围",
          "items": [
            "囚犯可以在可出入的区域内自由行动。",
            "若行动超出受允许区域，将视其违规。"
          ]
        },
        {
          "title": "受允许的活动",
          "items": [
            "在图书室内阅读。",
            "在娱乐室游玩。",
            "在野外运动或散步。",
            "不受允许的活动：集体抗议、策划逃走。"
          ]
        }
      ],
      "source": [
        "魔女图鉴·规定"
      ]
    }
  ]
}